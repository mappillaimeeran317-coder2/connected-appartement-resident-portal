{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin-portal", "destination": "/admin-portal/index.html" },
    { "source": "/admin-portal/", "destination": "/admin-portal/index.html" },
    { "source": "/admin-portal/:path*", "destination": "/admin-portal/:path*" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}
